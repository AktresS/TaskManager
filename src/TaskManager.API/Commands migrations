# Команды для работы с миграциями

# Создать миграцию
dotnet ef migrations add ИмяМиграции -s TaskManager.Web -p TaskManager.Data --output-dir Data/Migrations

#Если перейти в корень проекта то можно просто
dotnet ef migrations add ИмяМиграции

# Применить миграции
dotnet ef database update -s TaskManager.Web -p TaskManager.Data

# Откатить последнюю миграцию
dotnet ef migrations remove -s TaskManager.Web -p TaskManager.Data

