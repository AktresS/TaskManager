<MudDrawerHeader Style="padding: 20px 16px 12px;">
    <MudText Typo="Typo.subtitle2" Style="color:#555; font-weight:600; letter-spacing:1px; text-transform:uppercase; font-size:11px;">
        Navigation
    </MudText>
</MudDrawerHeader>

<MudNavMenu Style="padding: 0 8px;">

    <MudNavLink Href="/my-tasks"
                Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.TaskAlt"
                Style="border-radius:10px; margin-bottom:2px;">
        Мои задачи
    </MudNavLink>

    <MudNavLink Href="/projects"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.FolderOpen"
                Style="border-radius:10px; margin-bottom:2px;">
        Проекты
    </MudNavLink>

</MudNavMenu>

<style>
    /* Активная ссылка */
    .mud-nav-link.active {
        background: rgba(124, 106, 247, 0.15) !important;
        color: #7c6af7 !important;
    }
    .mud-nav-link.active .mud-nav-link-icon {
        color: #7c6af7 !important;
    }

    /* Обычная ссылка */
    .mud-nav-link {
        color: #888 !important;
        font-size: 14px !important;
        font-weight: 500 !important;
    }
    .mud-nav-link:hover {
        background: rgba(255,255,255,0.05) !important;
        color: #eaeaea !important;
    }
    .mud-nav-link:hover .mud-nav-link-icon {
        color: #eaeaea !important;
    }
    .mud-nav-link-icon {
        color: #555 !important;
    }
</style>
