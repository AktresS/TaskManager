@page "/projects"
@attribute [Authorize]

<PageTitle>Проекты</PageTitle>

<div class="projects-header">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateModal"
               Style="border-radius:10px; text-transform:none; font-weight:600; height:40px;">
        Новый проект
    </MudButton>
</div>

@if (isLoading)
{
    <div class="projects-grid">
        @for (int i = 0; i < 6; i++)
        {
            <div class="skeleton-card"></div>
        }
    </div>
}
else if (!string.IsNullOrEmpty(error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-4">@error</MudAlert>
}
else if (projects is null || projects.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">
            <MudIcon Icon="@Icons.Material.Outlined.FolderOpen"
                     Style="font-size:40px; color:#333;" />
        </div>
        <MudText Typo="Typo.h6" Style="color:#444; font-weight:600;">
            Проектов пока нет
        </MudText>
        <MudText Typo="Typo.body2" Style="color:#333; margin-top:4px;">
            Создайте первый проект чтобы начать
        </MudText>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateModal"
                   Style="margin-top:20px; border-radius:10px; text-transform:none; border-color:#2a2a2a; color:#666;">
            Создать проект
        </MudButton>
    </div>
}
else
{
    <div class="projects-grid">
        @foreach (var project in projects)
        {
            <div class="project-card" @onclick="() => GoToBoard(project.ProjectId)">

                <div class="project-card-header" style="background:@GetProjectColor(project.ProjectId);">
                    <div class="project-initials">@GetInitials(project.Name)</div>
                </div>

                <div class="project-card-body">
                    <div class="project-name">@project.Name</div>

                    @if (!string.IsNullOrEmpty(project.Description))
                    {
                        <div class="project-desc">@project.Description</div>
                    }

                    <div class="project-meta">
                        <span class="meta-item">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday"
                                     Style="font-size:12px;" />
                            @project.CreatedAt.ToString("dd MMM yyyy")
                        </span>
                    </div>
                </div>

                <div class="project-card-footer" @onclick:stopPropagation="true">
                    <MudButton Variant="Variant.Text"
                            StartIcon="@Icons.Material.Filled.Forum"
                            Size="Size.Small"
                            OnClick="() => GoToChat(project.ProjectId)"
                            Style="text-transform:none; color:#555; font-size:12px; padding:4px 8px;">
                        Чат
                    </MudButton>

                    <div style="display:flex; gap:4px;">
                        <MudTooltip Text="@(project.IsPinned ? "Открепить" : "Закрепить")">
                            <MudIconButton
                                Icon="@(project.IsPinned ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)"
                                Size="Size.Small"
                                Style="@(project.IsPinned ? "color:#f59e0b;" : "color:#444;")"
                                OnClick="() => TogglePin(project)" />
                        </MudTooltip>

                        <MudTooltip Text="Участники">
                            <MudIconButton Icon="@Icons.Material.Filled.Group"
                                        Size="Size.Small"
                                        Style="color:#444;"
                                        OnClick="() => OpenMembersModal(project)" />
                        </MudTooltip>

                        @if (CanEdit(project.ProjectId))
                        {
                            <MudTooltip Text="Редактировать">
                                <MudIconButton Icon="@Icons.Material.Filled.EditNote"
                                            Size="Size.Small"
                                            Style="color:#444;"
                                            OnClick="() => OpenEditModal(project)" />
                            </MudTooltip>
                        }

                        @if (CanDelete(project.ProjectId))
                        {
                            <MudTooltip Text="Удалить">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                            Size="Size.Small"
                                            Style="color:#444;"
                                            OnClick="() => ConfirmDelete(project)" />
                            </MudTooltip>
                        }
                    </div>
                </div>

            </div>
        }
    </div>
}

@code {
    private List<ProjectResponse>? projects;
    private Dictionary<int, MemberRole?> _projectRoles = new();
    private bool isLoading = true;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadProjects();

    private bool CanEdit(int projectId) =>
        _projectRoles.TryGetValue(projectId, out var role) &&
        (role == MemberRole.Owner);

    private bool CanDelete(int projectId) =>
        _projectRoles.TryGetValue(projectId, out var role) &&
        role == MemberRole.Owner;

    private bool CanManageMembers(int projectId) =>
        _projectRoles.TryGetValue(projectId, out var role) &&
        (role == MemberRole.Owner || role == MemberRole.Admin);

    private async Task LoadProjects()
    {
        isLoading = true;
        error = null;
        try 
        { 
            projects = await ProjectService.GetUserProjectsAsync();

            var roleTasks = projects.Select(async p =>
            {
                var role = await MemberService.GetMyRoleAsync(p.ProjectId);
                return (p.ProjectId, role);
            });

            var roles = await System.Threading.Tasks.Task.WhenAll(roleTasks);
            _projectRoles = roles.ToDictionary(x => x.ProjectId, x => x.role);
        
        }
        catch (Exception ex) { error = ex.Message; }
        finally { isLoading = false; }
    }
    
    private void GoToBoard(int id) => NavManager.NavigateTo($"/projects/{id}/board");
    private void GoToChat(int id) => NavManager.NavigateTo($"/chats?project={id}");

    private async Task OpenCreateModal()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        var parameters = new DialogParameters<CreateProjectModal>
        {
            { x => x.OnSave, EventCallback.Factory.Create<CreateProjectRequest>(this, HandleCreate) }
        };

        await DialogService.ShowAsync<CreateProjectModal>("", parameters, options);
    }

    private async Task HandleCreate(CreateProjectRequest request)
    {
        await ProjectService.CreateAsync(request);
        await LoadProjects();
    }

    private async Task OpenMembersModal(ProjectResponse project)
    {
        var parameters = new DialogParameters<ManageMembersModal>
        {
            { x => x.ProjectId, project.ProjectId },
            { x => x.CurrentUserRole, _projectRoles.TryGetValue(project.ProjectId, out var role) ? role : null }
        };

        await DialogService.ShowAsync<ManageMembersModal>("", parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseOnEscapeKey = true
            });
    }

    private async Task OpenEditModal(ProjectResponse project)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        var parameters = new DialogParameters<EditProjectModal>
        {
            { x => x.Project, project },
            { x => x.OnSave,  EventCallback.Factory.Create<(int, UpdateProjectRequest)>(this, HandleEdit) }
        };

        await DialogService.ShowAsync<EditProjectModal>("", parameters, options);
    }

    private async Task HandleEdit((int id, UpdateProjectRequest request) args)
    {
        await ProjectService.UpdateAsync(args.id, args.request);
        await LoadProjects();
    }

    private async Task TogglePin(ProjectResponse project)
    {
        project.IsPinned = await ProjectService.TogglePinAsync(project.ProjectId);
        PinStateService.NotifyChanged();
        StateHasChanged();
    }

    private async Task ConfirmDelete(ProjectResponse project)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title,   "Удалить проект?" },
            { x => x.Message, $"Проект «{project.Name}» и все его задачи будут удалены. Это действие нельзя отменить." },
            { x => x.OnConfirm, EventCallback.Factory.Create(this, async () =>
                {
                    await ProjectService.DeleteAsync(project.ProjectId);
                    await LoadProjects();
                })
            }
        };

        await DialogService.ShowAsync<ConfirmDialog>("", parameters, options);
    }

    // ── Helpers ──
    private static readonly string[] _colors =
    {
        "#5b4fcf", "#2563eb", "#0891b2", "#059669",
        "#d97706", "#dc2626", "#7c3aed", "#db2777"
    };

    private string GetProjectColor(int id) => _colors[id % _colors.Length];

    private string GetInitials(string name)
    {
        var words = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length >= 2
            ? $"{words[0][0]}{words[1][0]}".ToUpper()
            : name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper();
    }
}
