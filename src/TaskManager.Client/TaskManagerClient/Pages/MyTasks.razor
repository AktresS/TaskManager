@page "/my-tasks"
@attribute [Authorize]
<PageTitle>Мои задачи</PageTitle>

<div style="display:flex; align-items:center; gap:12px; margin-bottom:16px; flex-wrap:wrap;">
    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.FilterList"
               OnClick="() => _showFilters = !_showFilters"
               Style="@FilterButtonStyle">
        Фильтры
    </MudButton>

    <MudSpacer />

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateModal"
               Style="border-radius:10px; text-transform:none; font-weight:600; height:40px;">
        Новая задача
    </MudButton>

</div>

@if (_showFilters)
{
    <div class="board-filters" style="margin-bottom:16px;">
        <div class="filter-row">
            @foreach (var filter in _filters)
            {
                <button class="filter-chip @(_activeFilter == filter.Key ? "active" : "")"
                        @onclick="() => { _activeFilter = filter.Key; _currentPage = 1; }">
                    @filter.Label
                    <span class="chip-count">@GetFilterCount(filter.Key)</span>
                </button>
            }
        </div>

        <div class="filter-row">
            @foreach (var filter in _typeFilters)
            {
                <button class="filter-chip @(_typeFilter == filter.Key ? "active" : "")"
                        @onclick="() => { _typeFilter = filter.Key; _currentPage = 1; }">
                    @filter.Label
                </button>
            }
        </div>
    </div>
}

@if (isLoading)
{
    <div class="loading-state">
        @for (int i = 0; i < 4; i++)
        {
            <div class="skeleton-card"></div>
        }
    </div>
}
else if (!string.IsNullOrEmpty(error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-4">@error</MudAlert>
}
else if (FilteredTasks.Count == 0)
{
    <div class="empty-state">
        <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Style="font-size:48px; color:#2a2a2a;" />
        <MudText Typo="Typo.body1" Style="color:#444; margin-top:16px;">
            @(_activeFilter == "all" ? "Задач пока нет" : "Нет задач в этой категории")
        </MudText>
    </div>
}
else
{
    <div class="tasks-grid">
        @foreach (var task in PagedTasks)
        {
            <div class="task-card @GetCardAccent(task.Priority)" @onclick="() => StartEdit(task)">

                <div class="task-card-top">
                    <div class="priority-dot @GetPriorityDot(task.Priority)"></div>
                    <span class="state-pill @GetStatePill(task.State)">@GetStateLabel(task.State)</span>
                </div>

                <div class="task-title">@task.Title</div>

                @if (!string.IsNullOrEmpty(task.Description))
                {
                    <div class="task-desc">@task.Description</div>
                }

                <div class="task-project">
                    <MudIcon Icon="@Icons.Material.Filled.FolderOpen"
                             Style="font-size:13px; color:#444;" />
                    <span>@(task.ProjectName ?? "Личная задача")</span>
                </div>

                <div class="task-card-bottom">

                    <span class="deadline @GetDeadlineClass(task)">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule"
                                 Style="font-size:13px;" />
                        @task.DeadLine.ToString("dd MMM")
                    </span>

                    <div class="assignees">
                        @foreach (var a in task.Assignees.Take(3))
                        {
                            <div class="avatar-chip" title="@(a.Name ?? "?")">
                                @if (!string.IsNullOrEmpty(a.AvatarUrl))
                                {
                                    <img src="@a.AvatarUrl" 
                                        style="width:100%; height:100%; border-radius:50%; object-fit:cover;" />
                                }
                                else
                                {
                                    @((a.Name is { Length: > 0 } ? a.Name[0].ToString() : "?"))
                                }
                            </div>
                        }
                        @if (task.Assignees.Count > 3)
                        {
                            <div class="avatar-chip more">+@(task.Assignees.Count - 3)</div>
                        }
                    </div>

                    <div class="task-actions" @onclick:stopPropagation="true">
                        <MudButton Variant="Variant.Text"
                                StartIcon="@Icons.Material.Filled.Forum"
                                Size="Size.Small"
                                OnClick="() => GoToChat(task.Id)"
                                Style="text-transform:none; color:#555; font-size:12px; padding:4px 8px;">
                            Чат
                        </MudButton>
                        @if (task.State != TaskState.Completed)
                        {
                            <MudTooltip Text="Завершить">
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircleOutline"
                                            Size="Size.Small"
                                            Style="color:#444; padding:4px;"
                                            OnClick="() => MarkDone(task.Id)" />
                            </MudTooltip>

                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                    Style="font-size:16px; color:#22c55e; margin-left:auto;" />
                        }

                        <MudTooltip Text="Удалить">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Size="Size.Small"
                                       Style="color:#444; padding:4px;"
                                       OnClick="() => Delete(task.Id)" />
                        </MudTooltip>

                    </div>

                </div>

            </div>
        }
    </div>

    @if (TotalPages > 1)
    {
        <div style="display:flex; justify-content:center; margin-top:20px;">
            <MudPagination Count="@TotalPages"
                        @bind-Selected="_currentPage"
                        Color="Color.Primary"
                        Variant="Variant.Filled"
                        BoundaryCount="1"
                        MiddleCount="3" />
        </div>
    }
}

@code {
    private List<WorkItemResponse>? tasks;
    private bool isLoading = true;
    private string? error;
    private WorkItemResponse? editingTask;
    private UpdateWorkItemRequest editModel = new();
    private string _activeFilter = "all";
    private string _typeFilter = "all";
    private int _currentUserId;
    private bool _showFilters = false;
    private int _currentPage = 1;
    private const int PageSize = 12;

    private int TotalPages => (int)Math.Ceiling(FilteredTasks.Count / (double)PageSize);

    private string _searchValue = string.Empty;
    private string _search
    {
        get => _searchValue;
        set { _searchValue = value; _currentPage = 1; }
    }

    private void ResetPage() => _currentPage = 1;

    private List<WorkItemResponse> PagedTasks => FilteredTasks
        .Skip((_currentPage - 1) * PageSize)
        .Take(PageSize)
        .ToList();

    private string FilterButtonStyle =>
        _showFilters
            ? "border-radius:10px; text-transform:none; font-weight:500; border-color:#7c6af7; color:#7c6af7; font-size:13px;"
            : "border-radius:10px; text-transform:none; font-weight:500; border-color:#2a2a2a; color:#666; font-size:13px;";


    private record FilterItem(string Key, string Label);
    private readonly List<FilterItem> _filters = new()
    {
        new("all", "Все"),
        new("new", "Новые"),
        new("inprogress", "В работе"),
        new("onhold",     "Приостановленные"),
        new("done", "Завершённые"),
        new("overdue", "Просроченные"),
    };

    private readonly List<FilterItem> _typeFilters = new()
    {
        new("all",      "Все"),
        new("personal", "Личные"),
        new("project",  "Проектные"),
        new("assignee", "Я исполнитель"),
        new("created",  "Я создатель"),
    };

    private List<WorkItemResponse> FilteredTasks => (tasks ?? new())
        .Where(t => _activeFilter switch
        {
            "new"        => t.State == TaskState.New,
            "inprogress" => t.State == TaskState.InProgress,
            "onhold"     => t.State == TaskState.OnHold,
            "done"       => t.State == TaskState.Completed,
            "overdue"    => t.DeadLine < DateTime.Now && t.State != TaskState.Completed,
            _            => true
        })
        .Where(t => _typeFilter switch
        {
            "personal" => t.ProjectId == null,
            "project"  => t.ProjectId != null,
            "assignee" => t.Assignees.Any(a => a.Id == _currentUserId),
            "created"  => t.CreatedById == _currentUserId,
            _          => true
        })
        .Where(t => string.IsNullOrWhiteSpace(SearchService.SearchQuery) ||
                    t.Title.Contains(SearchService.SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (t.Description?.Contains(SearchService.SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.ProjectName?.Contains(SearchService.SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    private int GetFilterCount(string key) => (tasks ?? new()).Count(t => key switch
    {
        "new"        => t.State == TaskState.New,
        "inprogress" => t.State == TaskState.InProgress,
        "onhold" => t.State == TaskState.OnHold,
        "done"       => t.State == TaskState.Completed,
        "overdue"    => t.DeadLine < DateTime.Now && t.State != TaskState.Completed,
        _            => true
    });

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var claim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (claim != null) int.TryParse(claim.Value, out _currentUserId);

        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        isLoading = true;
        error = null;
        try { tasks = await TaskService.GetMyAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { isLoading = false; }
    }

    protected override void OnInitialized()
    {
        SearchService.OnChanged += StateHasChanged;
    }

    public void Dispose()
    {
        SearchService.OnChanged -= StateHasChanged;
    }

    private string GetCardAccent(TaskPriority p) => p switch
    {
        TaskPriority.High   => "accent-red",
        TaskPriority.Medium => "accent-yellow",
        TaskPriority.Low    => "accent-green",
        _                   => "accent-gray"
    };

    private string GetPriorityDot(TaskPriority p) => p switch
    {
        TaskPriority.High   => "dot-red",
        TaskPriority.Medium => "dot-yellow",
        TaskPriority.Low    => "dot-green",
        _                   => "dot-gray"
    };

    private string GetStatePill(TaskState s) => s switch
    {
        TaskState.InProgress => "pill-inprogress",
        TaskState.Completed  => "pill-done",
        TaskState.OnHold     => "pill-onhold",
        _                    => "pill-new"
    };

    private string GetStateLabel(TaskState s) => s switch
    {
        TaskState.New        => "Новая",
        TaskState.InProgress => "В работе",
        TaskState.OnHold     => "Приостановлена",
        TaskState.Completed  => "Готово",
        _                    => s.ToString()
    };

    private string GetDeadlineClass(WorkItemResponse task)
    {
        if (task.State == TaskState.Completed)
            return task.CompletedAt.HasValue && task.CompletedAt.Value <= task.DeadLine 
                ? "ontime" 
                : "overdue";

        if (task.DeadLine < DateTime.Now) return "overdue";
        if ((task.DeadLine - DateTime.Now).Days <= 2) return "soon";
        return "normal";
    }

    
    private void GoToChat(int id) => NavManager.NavigateTo($"/chats?task={id}");

    private async Task MarkDone(int id)
    {
        await TaskService.UpdateAsync(id, new UpdateWorkItemRequest { State = TaskState.Completed });
        await LoadTasks();
    }

    private async Task Delete(int id)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title,   "Удалить задачу?" },
            { x => x.Message, "Задача будет удалена. Это действие нельзя отменить." },
            { x => x.OnConfirm, EventCallback.Factory.Create(this, async () =>
                {
                    await TaskService.DeleteAsync(id);
                    await LoadTasks();
                })
            }
        };

        await DialogService.ShowAsync<ConfirmDialog>("", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
    }
    private async Task OpenCreateModal()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        var parameters = new DialogParameters<CreateTaskModal>
        {
            { x => x.OnSave, EventCallback.Factory.Create<CreatePersonalWorkItemRequest>(this, HandleCreate) }
        };

        await DialogService.ShowAsync<CreateTaskModal>("", parameters, options);
    }

    private async Task StartEdit(WorkItemResponse task)
    {
        editingTask = task;

        editModel = new UpdateWorkItemRequest
        {
            Title       = task.Title,
            Description = task.Description,
            Priority    = task.Priority,
            State       = task.State,
            DeadLine    = task.DeadLine
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        var parameters = new DialogParameters<EditTaskModal>
        {
            { x => x.Model,   editModel },
            { x => x.OnSave,  EventCallback.Factory.Create<UpdateWorkItemRequest>(this, SaveEdit) }
        };

        await DialogService.ShowAsync<EditTaskModal>("", parameters, options);
    }

    private async Task SaveEdit(UpdateWorkItemRequest model)
    {
        if (editingTask == null) return;
        await TaskService.UpdateAsync(editingTask.Id, model);
        await LoadTasks();
    }

    private async Task HandleCreate(CreatePersonalWorkItemRequest model)
    {
        await TaskService.CreatePersonalAsync(model);
        await LoadTasks();
    }
}
