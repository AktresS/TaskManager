@page "/projects/{ProjectId:int}/board"
@attribute [Authorize]


<PageTitle>Доска проекта</PageTitle>

<div class="board-header">
    <div style="display:flex; align-items:center; gap:8px;">        
        <MudButton Variant="Variant.Outlined"
                StartIcon="@Icons.Material.Filled.ViewKanban"
                OnClick='() => NavManager.NavigateTo($"/projects/{ProjectId}/board")'
                Style="@GetNavButtonStyle("board")">
            Канбан-доска
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                StartIcon="@Icons.Material.Filled.BarChart"
                OnClick='() => NavManager.NavigateTo($"/projects/{ProjectId}/gantt")'
                Style="@GetNavButtonStyle("gantt")">
            Диаграмма Ганта
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                StartIcon="@Icons.Material.Filled.PieChart"
                OnClick='() => NavManager.NavigateTo($"/projects/{ProjectId}/stats")'
                Style="@GetNavButtonStyle("stats")">
            Статистика
        </MudButton>
        <div style="display:flex; align-items:center; gap:12px;">
            <MudButton Variant="Variant.Outlined"
                    StartIcon="@Icons.Material.Filled.FilterList"
                    OnClick="() => _showFilters = !_showFilters"
                    Style="@FilterButtonStyle">
                Фильтры
            </MudButton>
        </div>
    </div>

    <div style="display:flex; align-items:center; gap:8px;">
        @if (boards.Count > 0)
        {
            <div class="board-tabs">
                @foreach (var board in boards)
                {
                    <button class="board-tab @(activeBoardId == board.Id ? "active" : "")"
                            @onclick="() => SwitchBoard(board.Id)">
                        @board.Name
                        @if (CanManageBoard)
                        {
                            <span class="tab-delete" @onclick:stopPropagation="true"
                            @onclick="() => ConfirmDeleteBoard(board)">×</span>
                        }
                    </button>
                }
            </div>
        }

        <MudTooltip Text="Новая доска">
            <MudIconButton Icon="@Icons.Material.Filled.AddBox"
                        Size="Size.Small"
                        Style="color:#555;"
                        OnClick="OpenCreateBoardModal" />
        </MudTooltip>
        
    </div>
</div>

@if (_showFilters)
{
    <div class="board-filters">

        <div class="filter-row">
            @foreach (var filter in _filters)
            {
                <button class="filter-chip @(_activeFilter == filter.Key ? "active" : "")"
                        @onclick="() => _activeFilter = filter.Key">
                    @filter.Label
                    <span class="chip-count">@GetFilterCount(filter.Key)</span>
                </button>
            }
        </div>

        <div class="filter-row" style="margin-top:-8px;">
            @foreach (var filter in _typeFilters)
            {
                <button class="filter-chip @(_typeFilter == filter.Key ? "active" : "")"
                        @onclick="() => _typeFilter = filter.Key">
                    @filter.Label
                </button>
            }
        </div>
    </div>
}

@if (isLoading)
{
    <div class="columns-row">
        @for (int i = 0; i < 3; i++)
        {
            <div class="column-skeleton"></div>
        }
    </div>
}
else if (boards.Count == 0)
{
    <div class="empty-state">
        <MudIcon Icon="@Icons.Material.Outlined.Dashboard" Style="font-size:48px; color:#2a2a2a;" />
        <MudText Typo="Typo.body1" Style="color:#444; margin-top:16px;">Досок пока нет</MudText>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateBoardModal"
                   Style="margin-top:16px; border-radius:10px; text-transform:none; border-color:#2a2a2a; color:#666;">
            Создать доску
        </MudButton>
    </div>
}
else
{
    <div class="columns-row">
        @foreach (var column in columns)
        {
            var col = column;
            <div class="kanban-column @(draggingColumnId == col.Id ? "column-dragging" : "") @(dragOverColumnId == col.Id ? "column-drag-over" : "")"
                @key="col.Id"
                draggable="@(CanManageBoard ? "true" : "false")"
                @ondragstart="() => OnColumnDragStart(col.Id)"
                @ondragend="OnColumnDragEnd"
                @ondragenter="() => { if (draggingColumnId != null && dragOverColumnId != col.Id) { dragOverColumnId = col.Id; StateHasChanged(); } }"
                @ondragover:preventDefault="true"
                @ondrop="() => OnColumnDrop(col.Id)"
                @ondrop:preventDefault="true">

                <div class="column-header">
                    <div style="display:flex; align-items:center; gap:8px;">
                        @if (CanManageBoard)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                    Style="font-size:16px; color:#333; cursor:grab;" />
                        }
                        <div class="column-dot" style="background:@GetColumnColor(col.Order);"></div>
                        <span class="column-name">@col.Name</span>
                        <span class="column-count">@GetFilteredTasks(col).Count()</span>
                    </div>

                    <div class="column-actions">
                        <MudTooltip Text="Добавить задачу">
                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           Style="color:#444; padding:2px;"
                                           OnClick="() => OpenAddTaskModal(col.Id)" />
                        </MudTooltip>
                        @if (CanManageBoard)
                        {
                            <MudTooltip Text="Настройки колонки">
                                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                                            Size="Size.Small"
                                            Style="color:#444; padding:2px;"
                                            OnClick="() => OpenColumnSettings(col)" />
                            </MudTooltip>
                            <MudTooltip Text="Удалить колонку">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                            Size="Size.Small"
                                            Style="color:#444; padding:2px;"
                                            OnClick="() => ConfirmDeleteColumn(col)" />
                            </MudTooltip>
                        }
                    </div>
                </div>

                <div class="column-cards">
                    @foreach (var task in GetFilteredTasks(col))
                    {
                        var t = task;
                        <div class="task-card @(draggingTaskId == t.Id ? "dragging" : "")"
                             @key="t.Id"
                             draggable="true"
                             @ondragstart="() => OnDragStart(t.Id)"
                             @ondragend="OnDragEnd"
                             @onclick="() => OpenTaskDetail(t)">

                            <div class="task-card-top">
                                <div class="priority-dot @GetPriorityDot(t.Priority)"></div>
                                
                                <div @onclick:stopPropagation="true" style="position:relative;">
                                    <MudMenu @ref="_stateMenus[t.Id]"
                                            AnchorOrigin="Origin.BottomLeft"
                                            TransformOrigin="Origin.TopLeft"
                                            Dense="true">
                                        <ChildContent>
                                            @foreach (var state in Enum.GetValues<TaskState>())
                                            {
                                                var s = state;
                                                <MudMenuItem OnClick="() => ChangeState(t, s)">
                                                    <div style="display:flex; align-items:center; gap:8px;">
                                                        <div style="width:8px; height:8px; border-radius:50%; background:@GetStateColor(s);"></div>
                                                        @GetStateLabel(s)
                                                    </div>
                                                </MudMenuItem>
                                            }
                                        </ChildContent>
                                    </MudMenu>
                                    <span class="state-pill @GetStatePill(t.State)"
                                        style="cursor:pointer;"
                                        @onclick="args => { if (_stateMenus.TryGetValue(t.Id, out var m) && m != null) m.OpenMenuAsync(args); }">
                                        @GetStateLabel(t.State)
                                    </span>
                                </div>
                            </div>

                            <div class="task-title">@t.Title</div>

                            @if (!string.IsNullOrEmpty(t.Description))
                            {
                                <div class="task-desc">@t.Description</div>
                            }

                            <div class="task-footer">
                                <span class="deadline @GetDeadlineClass(task)">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule"
                                            Style="font-size:13px;" />
                                    @task.DeadLine.ToString("dd MMM")
                                </span>

                                <div class="assignees">
                                    @foreach (var a in task.Assignees.Take(3))
                                    {
                                        <div class="avatar-chip" title="@(a.Name ?? "?")">
                                            @if (!string.IsNullOrEmpty(a.AvatarUrl))
                                            {
                                                <img src="@a.AvatarUrl" 
                                                    style="width:100%; height:100%; border-radius:50%; object-fit:cover;" />
                                            }
                                            else
                                            {
                                                @((a.Name is { Length: > 0 } ? a.Name[0].ToString() : "?"))
                                            }
                                        </div>
                                    }
                                    @if (task.Assignees.Count > 3)
                                    {
                                        <div class="avatar-chip more">+@(task.Assignees.Count - 3)</div>
                                    }
                                </div>

                                <div @onclick:stopPropagation="true">
                                    <MudTooltip Text="Чат задачи">
                                        <MudIconButton Icon="@Icons.Material.Filled.Forum"
                                                    Size="Size.Small"
                                                    Style="color:#444; padding:2px;"
                                                    OnClick="() => GoToChat(t.Id)" />
                                    </MudTooltip>

                                    @if (CanEditTask(t))
                                    {
                                        @if (t.State != TaskState.Completed)
                                        {
                                            <MudTooltip Text="Завершить">
                                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircleOutline"
                                                            Size="Size.Small"
                                                            Style="color:#444; padding:2px;"
                                                            OnClick="() => MarkDone(t)" />
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                    Style="font-size:16px; color:#22c55e;" />
                                        }

                                        <MudTooltip Text="Удалить">
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                        Size="Size.Small"
                                                        Style="color:#444; padding:4px;"
                                                        OnClick="() => Delete(t.Id)" />
                                        </MudTooltip>
                                    }
                                </div>
                            </div>

                        </div>
                    }
                </div>

            </div>
        }

        <div class="add-column-btn" @onclick="OpenCreateColumnModal">
            <MudIcon Icon="@Icons.Material.Filled.Add" Style="font-size:18px; color:#444;" />
            <span>Добавить колонку</span>
        </div>
    </div>
}

@code {
    [Parameter] public int ProjectId { get; set; }
    private MudMenu _testMenu = default!;
    private List<BoardBaseResponse> boards = new();
    private List<ColumnBaseResponse> columns = new();
    private Dictionary<int, MudMenu> _stateMenus = new();
    private int? activeBoardId;
    private bool isLoading = true;
    private int? draggingTaskId;
    private int _loadedProjectId = -1;
    private bool _showFilters = false;
    private string _search = string.Empty;
    private string _activeFilter = "all";
    private string _typeFilter = "all";
    private int _currentUserId;
    private string? _projectName;
    private MemberRole? _currentUserRole;
    private int? draggingColumnId;
    private int? dragOverColumnId;

    private bool CanManageBoard => _currentUserRole == MemberRole.Owner || _currentUserRole == MemberRole.Admin;

    private record FilterItem(string Key, string Label);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var claim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (claim != null) int.TryParse(claim.Value, out _currentUserId);

        // Проверяем boardId в URL
        var uri = new Uri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var boardIdParam = query["boardId"];
        Console.WriteLine($"boardIdParam: {boardIdParam}");

        try
        {
            var projectTask = ProjectService.GetByIdAsync(ProjectId);
            var roleTask    = MemberService.GetMyRoleAsync(ProjectId);
            await System.Threading.Tasks.Task.WhenAll(projectTask, roleTask);

            _projectName = projectTask.Result?.Name;
            _currentUserRole  = roleTask.Result;
            ProjectContext.SetProject(_projectName);

            await LoadBoards();

            if (!string.IsNullOrEmpty(boardIdParam) && int.TryParse(boardIdParam, out var boardId))
            {
                var targetBoard = boards.FirstOrDefault(b => b.Id == boardId);
                if (targetBoard != null && activeBoardId != targetBoard.Id)
                {
                    activeBoardId = targetBoard.Id;
                    await LoadColumns();
                }
            }
        }
        finally { isLoading = false; }
    }

    protected override void OnInitialized()
    {
        SearchService.OnChanged += StateHasChanged;
    }

    public void Dispose()
    {
        SearchService.OnChanged -= StateHasChanged;
    }

    private readonly List<FilterItem> _filters = new()
    {
        new("all",        "Все"),
        new("new",        "Новые"),
        new("inprogress", "В работе"),
        new("onhold",     "Приостановлены"),
        new("done",       "Завершённые"),
        new("overdue",    "Просроченные"),
    };

    private readonly List<FilterItem> _typeFilters = new()
    {
        new("all",      "Все"),
        new("assignee", "Я исполнитель"),
        new("created",  "Я создатель"),
    };

    private int GetFilterCount(string key) => columns
        .SelectMany(c => c.WorkItems)
        .Count(t => key switch
        {
            "new"        => t.State == TaskState.New,
            "inprogress" => t.State == TaskState.InProgress,
            "onhold"     => t.State == TaskState.OnHold,
            "done"       => t.State == TaskState.Completed,
            "overdue"    => t.DeadLine < DateTime.Now && t.State != TaskState.Completed,
            _            => true
        });

    private void OnColumnDragStart(int columnId)
    {
        if (draggingTaskId is not null) return;
        draggingColumnId = columnId;
    }

    private void OnColumnDragEnd()
    {
        draggingColumnId = null;
        dragOverColumnId = null;
    }

    private async Task OnColumnDrop(int targetColumnId)
    {
        if (draggingTaskId is not null)
        {
            draggingColumnId = null;
            dragOverColumnId = null;
            await OnDrop(targetColumnId);
            return;
        }

        if (draggingColumnId is null || draggingColumnId == targetColumnId)
        {
            draggingColumnId = null;
            dragOverColumnId = null;
            return;
        }

        var sourceCol = columns.FirstOrDefault(c => c.Id == draggingColumnId);
        var targetCol = columns.FirstOrDefault(c => c.Id == targetColumnId);

        if (sourceCol is null || targetCol is null) return;

        var sourceOrder = sourceCol.Order;
        var targetOrder = targetCol.Order;

        sourceCol.Order = targetOrder;
        targetCol.Order = sourceOrder;

        columns = columns.OrderBy(c => c.Order).ToList();

        draggingColumnId = null;
        dragOverColumnId = null;

        _ = ColumnService.UpdateAsync(sourceCol.Id, activeBoardId!.Value, 
            new UpdateColumnRequest { Order = sourceCol.Order });
        _ = ColumnService.UpdateAsync(targetCol.Id, activeBoardId!.Value, 
            new UpdateColumnRequest { Order = targetCol.Order });
    }

    private void OnColumnDragOver(int columnId)
    {
        if (draggingColumnId is null) return;
        if (dragOverColumnId == columnId) return;
            dragOverColumnId = columnId;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId != _loadedProjectId)
        {
            _loadedProjectId = ProjectId;
            activeBoardId = null;
            boards = new();
            columns = new();
            isLoading = true;
            StateHasChanged(); 
            await LoadBoards();
        }

        var uri = new Uri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var boardIdParam = query["boardId"];

        if (!string.IsNullOrEmpty(boardIdParam) && int.TryParse(boardIdParam, out var boardId))
        {
            if (boards.Any() && activeBoardId != boardId)
            {
                var targetBoard = boards.FirstOrDefault(b => b.Id == boardId);
                if (targetBoard != null)
                    await SwitchBoard(targetBoard.Id);
            }
        }
    }

    private string GetNavButtonStyle(string page)
    {
        var path = new Uri(NavManager.Uri).AbsolutePath.ToLower();
        var isActive = page == "board" ? path.Contains("/board") :
                    page == "gantt" ? path.Contains("/gantt") :
                    page == "stats" ? path.Contains("/stats") : false;

        return isActive
            ? "border-radius:10px; text-transform:none; font-weight:500; border-color:#7c6af7; color:#7c6af7; font-size:13px;"
            : "border-radius:10px; text-transform:none; font-weight:500; border-color:#2a2a2a; color:#666; font-size:13px;";
    }

    private async Task LoadBoards()
    {
        isLoading = true;
        try
        {
            boards = await BoardService.GetByProjectAsync(ProjectId);
            if (boards.Count > 0)
            {
                activeBoardId = boards[0].Id;
                await LoadColumns();
            }
        }
        finally { isLoading = false; }
    }

    private async Task LoadColumns()
    {
        if (activeBoardId is null) return;
        columns = await ColumnService.GetByBoardAsync(activeBoardId.Value);
    }


    private async Task SaveMoveAsync(int taskId, int columnId)
    {
        try
        {
            await TaskService.MoveAsync(taskId, columnId);
        }
        catch{ }
    }

    private async Task SwitchBoard(int boardId)
    {
        activeBoardId = boardId;
        isLoading = true;
        await LoadColumns();
        isLoading = false;
    }

    private void OnDragStart(int taskId) => draggingTaskId = taskId;
    private void OnDragEnd() { draggingTaskId = null; }

    private async Task OnDrop(int targetColumnId)
    {
        if (draggingTaskId is null) return;

        WorkItemResponse? task = null;
        ColumnBaseResponse? sourceCol = null;

        foreach (var col in columns)
        {
            var found = col.WorkItems.FirstOrDefault(t => t.Id == draggingTaskId);
            if (found != null) { task = found; sourceCol = col; break; }
        }

        draggingTaskId = null;

        if (task is null || sourceCol is null || sourceCol.Id == targetColumnId) return;

        sourceCol.WorkItems.Remove(task);
        var targetCol = columns.First(c => c.Id == targetColumnId);
        targetCol.WorkItems.Add(task);  // только один раз

        if (targetCol.AutoStatus.HasValue)
        {
            task.State = targetCol.AutoStatus.Value;
            if (targetCol.AutoStatus.Value == TaskState.Completed)
                task.CompletedAt = DateTime.UtcNow;
            else
                task.CompletedAt = null;
        }

        _ = SaveMoveAsync(task.Id, targetColumnId);
    }

    private string FilterButtonStyle =>
        _showFilters
            ? "border-radius:10px; text-transform:none; font-weight:500; border-color:#7c6af7; color:#7c6af7; font-size:13px;"
            : "border-radius:10px; text-transform:none; font-weight:500; border-color:#2a2a2a; color:#666; font-size:13px;";

    private async Task OpenTaskDetail(WorkItemResponse task)
    {
        if (!CanEditTask(task)) return;
        var parameters = new DialogParameters<EditProjectTaskModal>
        {
            { x => x.WorkItem, task },
            { x => x.ProjectId, ProjectId },
            { x => x.OnSave, EventCallback.Factory.Create<WorkItemResponse>(this, _ => LoadColumns()) }
        };

        await DialogService.ShowAsync<EditProjectTaskModal>("", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
    }

    private bool CanEditTask(WorkItemResponse task) =>
            task.CreatedById == _currentUserId ||
            _currentUserRole == MemberRole.Owner ||
            _currentUserRole == MemberRole.Admin;

    private async Task ChangeState(WorkItemResponse task, TaskState newState)
    {
        if (task.State == newState) return;
        var updated = await TaskService.UpdateAsync(task.Id, 
            new UpdateWorkItemRequest { State = newState });
        task.State       = updated.State;
        task.CompletedAt = updated.CompletedAt;
    }

    private string GetStateColor(TaskState? s) => s switch
    {
        TaskState.InProgress => "#7c6af7",
        TaskState.Completed  => "#22c55e",
        TaskState.OnHold     => "#f59e0b",
        _                    => "#555"
    };

    private void GoToChat(int id) => NavManager.NavigateTo($"/chats?task={id}");

    private async Task MarkDone(WorkItemResponse task)
    {
        var updated = await TaskService.UpdateAsync(task.Id, 
            new UpdateWorkItemRequest { State = TaskState.Completed });
        
        task.State       = updated.State;
        task.CompletedAt = updated.CompletedAt;
    }
    private async Task Delete(int id)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title,   "Удалить задачу?" },
            { x => x.Message, "Задача будет удалена. Это действие нельзя отменить." },
            { x => x.OnConfirm, EventCallback.Factory.Create(this, async () =>
                {
                    await TaskService.DeleteAsync(id);
                    await LoadColumns();
                })
            }
        };

        await DialogService.ShowAsync<ConfirmDialog>("", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
    }


    private async Task OpenCreateBoardModal()
    {
        var parameters = new DialogParameters<CreateNameModal>
        {
            { x => x.Title, "Новая доска" },
            { x => x.Label, "Название доски" },
            { x => x.Icon, Icons.Material.Filled.Dashboard },
            { x => x.OnSave, EventCallback.Factory.Create<string>(this, async name =>
                {
                    await BoardService.CreateAsync(ProjectId, new CreateBoardRequest { Name = name });
                    await LoadBoards();
                })
            }
        };

        await DialogService.ShowAsync<CreateNameModal>("", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });
    }

    private async Task ConfirmDeleteBoard(BoardBaseResponse board)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "Удалить доску?" },
            { x => x.Message, $"Доска «{board.Name}» будет удалена." },
            { x => x.OnConfirm, EventCallback.Factory.Create(this, async () =>
                {
                    await BoardService.DeleteAsync(ProjectId, board.Id);
                    await LoadBoards();
                })
            }
        };

        await DialogService.ShowAsync<ConfirmDialog>("", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
    }

    private async Task OpenCreateColumnModal()
    {
        if (activeBoardId is null) return;

        var parameters = new DialogParameters<CreateNameModal>
        {
            { x => x.Title, "Новая колонка" },
            { x => x.Label, "Название колонки" },
            { x => x.Icon, Icons.Material.Filled.ViewColumn },
            { x => x.OnSave, EventCallback.Factory.Create<string>(this, async name =>
                {
                    await ColumnService.CreateAsync(activeBoardId.Value,
                        new CreateColumnRequest { Name = name });
                    await LoadColumns();
                })
            }
        };

        await DialogService.ShowAsync<CreateNameModal>("", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });
    }

    private async Task ConfirmDeleteColumn(ColumnBaseResponse column)
    {
        if (activeBoardId is null) return;

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "Удалить колонку?" },
            { x => x.Message, $"Колонка «{column.Name}» и все её задачи будут откреплены." },
            { x => x.OnConfirm, EventCallback.Factory.Create(this, async () =>
                {
                    await ColumnService.DeleteAsync(column.Id, activeBoardId.Value);
                    await LoadColumns();
                })
            }
        };

        await DialogService.ShowAsync<ConfirmDialog>("", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
    }

    private IEnumerable<WorkItemResponse> GetFilteredTasks(ColumnBaseResponse col) =>
        col.WorkItems
            .Where(t => _activeFilter switch
            {
                "new"        => t.State == TaskState.New,
                "inprogress" => t.State == TaskState.InProgress,
                "onhold"     => t.State == TaskState.OnHold,
                "done"       => t.State == TaskState.Completed,
                "overdue"    => t.DeadLine < DateTime.Now && t.State != TaskState.Completed,
                _            => true
            })
            .Where(t => _typeFilter switch
            {
                "assignee" => t.Assignees.Any(a => a.Id == _currentUserId),
                "created"  => t.CreatedById == _currentUserId,
                _          => true
            })
            .Where(t => string.IsNullOrWhiteSpace(SearchService.SearchQuery) ||
                        t.Title.Contains(SearchService.SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                        (t.Description?.Contains(SearchService.SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    private async Task OpenAddTaskModal(int columnId)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        var parameters = new DialogParameters<CreateProjectTaskModal>
        {
            { x => x.ProjectId, ProjectId },
            { x => x.ColumnId, columnId },
            { x => x.OnSave, EventCallback.Factory.Create<CreateProjectWorkItemRequest>(this, async model =>
                {
                    await TaskService.CreateProjectAsync(ProjectId, columnId, model);
                    await LoadColumns();
                })
            }
        };

        await DialogService.ShowAsync<CreateProjectTaskModal>("", parameters, options);
    }

    private async Task OpenColumnSettings(ColumnBaseResponse column)
    {
        var parameters = new DialogParameters<ColumnSettingsModal>
        {
            { x => x.Column, column },
            { x => x.OnSave, EventCallback.Factory.Create<UpdateColumnRequest>(this, async request =>
                {
                    await ColumnService.UpdateAsync(column.Id, activeBoardId!.Value, request);
                    column.AutoStatus = request.ClearAutoStatus ? null : request.AutoStatus;
                })
            }
        };

        await DialogService.ShowAsync<ColumnSettingsModal>("", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });
    }

    private static readonly string[] _columnColors =
        { "#7c6af7", "#2563eb", "#059669", "#d97706", "#dc2626", "#0891b2" };

    private string GetColumnColor(int order) =>
        _columnColors[(order - 1) % _columnColors.Length];

    private string GetPriorityDot(TaskPriority? p) => p switch
    {
        TaskPriority.High   => "dot-red",
        TaskPriority.Medium => "dot-yellow",
        TaskPriority.Low    => "dot-green",
        _                   => "dot-gray"
    };

    private string GetStatePill(TaskState? s) => s switch
    {
        TaskState.InProgress => "pill-inprogress",
        TaskState.OnHold     => "pill-onhold",
        TaskState.Completed  => "pill-done",
        _                    => "pill-new"
    };

    private string GetStateLabel(TaskState? s) => s switch
    {
        TaskState.New        => "Новая",
        TaskState.InProgress => "В работе",
        TaskState.OnHold     => "Приостановлена",
        TaskState.Completed  => "Готово",
        _                    => "—"
    };

    private string GetDeadlineClass(WorkItemResponse task)
    {
        if (task.State == TaskState.Completed)
            return task.CompletedAt.HasValue && task.CompletedAt.Value <= task.DeadLine 
                ? "ontime" 
                : "overdue";

        if (task.DeadLine < DateTime.Now) return "overdue";
        if ((task.DeadLine - DateTime.Now).Days <= 2) return "soon";
        return "normal";
    }
}
