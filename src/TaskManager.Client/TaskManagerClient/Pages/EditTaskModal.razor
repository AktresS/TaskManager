@if (IsOpen)
{
    <div class="modal-backdrop-custom">
        <div class="modal-container">

            <div class="modal-header">
                <h5>Редактирование задачи</h5>
                <button class="btn-close" @onclick="Close"></button>
            </div>

            <EditForm Model="Model" OnValidSubmit="Save">
                <DataAnnotationsValidator />

                <div class="mb-2">
                    <InputText class="form-control" @bind-Value="Model.Title" />
                </div>

                <div class="mb-2">
                    <InputText class="form-control" @bind-Value="Model.Description" />
                </div>

                <div class="mb-2">
                    <InputSelect class="form-control" @bind-Value="Model.Priority">
                        @foreach (var p in Enum.GetValues<TaskPriority>())
                        {
                            <option value="@p">@p</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-2">
                    <InputSelect class="form-control" @bind-Value="Model.State">
                        @foreach (var s in Enum.GetValues<TaskState>())
                        {
                            <option value="@s">@s</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <InputDate class="form-control" @bind-Value="Model.DeadLine" />
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary">Сохранить</button>
                    <button type="button" class="btn btn-secondary" @onclick="Close">Отмена</button>
                </div>

            </EditForm>

        </div>
    </div>
}

@code{
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public UpdateWorkItemRequest Model { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<UpdateWorkItemRequest> OnSave { get; set; }

    private async Task Save()
    {
        await OnSave.InvokeAsync(Model);
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}