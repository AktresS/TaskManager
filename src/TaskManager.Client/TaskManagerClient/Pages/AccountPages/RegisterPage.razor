@page "/identity/account/register"
@layout AuthenticationLayout

<MudPaper Class="auth-card" Elevation="0">

    <MudText Typo="Typo.h5" Class="mb-1" Style="font-weight:700; color:#eaeaea;">
        Создание аккаунта
    </MudText>
    <MudText Typo="Typo.body2" Style="color:#888; margin-bottom:32px;">
        Зарегистрируйтесь, чтобы начать
    </MudText>

    <EditForm Model="User" OnValidSubmit="HandleRegistration">
        <DataAnnotationsValidator />

        <MudTextField @bind-Value="User.Name"
                      Label="Имя"
                      Variant="Variant.Outlined"
                      Class="mb-4"
                      FullWidth="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Person" />

        <MudTextField @bind-Value="User.Email"
                      Label="Электронная почта"
                      InputType="InputType.Email"
                      Variant="Variant.Outlined"
                      Class="mb-4"
                      FullWidth="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Email" />

        <MudTextField @bind-Value="User.Password"
                      Label="Пароль"
                      InputType="@_passwordInput"
                      Variant="Variant.Outlined"
                      Class="mb-4"
                      FullWidth="true"
                      Adornment="Adornment.End"
                      AdornmentIcon="@_passwordIcon"
                      OnAdornmentClick="TogglePassword" />

        <MudTextField @bind-Value="User.ConfirmPassword"
                      Label="Подтвердите пароль"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Class="mb-2"
                      FullWidth="true" />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" Variant="Variant.Filled">
                @_error
            </MudAlert>
        }

        @if (_success)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4" Variant="Variant.Filled">
                Аккаунт создан! Переходим к входу...
            </MudAlert>
        }

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   Disabled="_loading"
                   Class="mt-4 auth-btn">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Создание аккаунта...</span>
            }
            else
            {
                <span>Зарегистрироваться</span>
            }
        </MudButton>

    </EditForm>

    <MudDivider Class="my-5" Style="border-color:#2e2e2e;" />

    <MudText Typo="Typo.body2" Align="Align.Center" Style="color:#888;">
        Уже есть аккаунт?
        <MudLink Href="/identity/account/login" Style="color:#7c6af7; font-weight:600;">
            Войти
        </MudLink>
    </MudText>

</MudPaper>

<style>
    .auth-card {
        width: 100%;
        max-width: 420px;
        padding: 48px 40px;
        background: #1e1e1e;
        border: 1px solid #2a2a2a;
        border-radius: 16px;
    }

    .auth-btn {
        height: 48px;
        border-radius: 10px;
        font-weight: 600;
        letter-spacing: 0.3px;
        text-transform: none !important;
        font-size: 15px;
    }

    .mud-input-outlined .mud-input-outlined-border {
        border-color: #333 !important;
    }
    .mud-input-outlined:hover .mud-input-outlined-border {
        border-color: #7c6af7 !important;
    }

    .mud-input-label { color: #666 !important; }
    .mud-input-root { color: #eaeaea !important; }

    .mud-input-adornment-start + .mud-input {
        padding-left: 6px !important;
    }

    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus,
    input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 100px #2a2a2a inset !important;
        -webkit-text-fill-color: #eaeaea !important;
        caret-color: #eaeaea;
        transition: background-color 9999s ease-in-out 0s;
    }

    .mud-input-outlined:has(input:-webkit-autofill) .mud-input-adornment {
        color: #7c6af7 !important;
    }
</style>

@code {
    Register User = new();
    bool _loading;
    bool _success;
    string? _error;
    InputType _passwordInput = InputType.Password;
    string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    void TogglePassword()
    {
        if (_passwordInput == InputType.Password)
        {
            _passwordInput = InputType.Text;
            _passwordIcon = Icons.Material.Filled.Visibility;
        }
        else
        {
            _passwordInput = InputType.Password;
            _passwordIcon = Icons.Material.Filled.VisibilityOff;
        }
    }

    async Task HandleRegistration()
    {
        _loading = true;
        _error = null;

        var result = await accountService.CreateAsync(User);
        if (result.Flag)
        {
            _success = true;
            await Task.Delay(1200); // дать пользователю увидеть success
            NavManager.NavigateTo("/identity/account/login");
        }
        else
        {
            _error = result.Message;
        }

        _loading = false;
    }
}