@page "/"
@layout LandingLayout
<div class="landing-container">
    <div class="landing-content">
        <h1 class="title">Task Messenger</h1>

        <p class="subtitle">
            Manage your tasks and communicate with your team in one place
        </p>

        <div class="buttons">
            <a href="/identity/account/login" class="btn primary">Login</a>
            <a href="/identity/account/register" class="btn secondary">Register</a>
        </div>
    </div>

    <div class="preview">
        <img src="images/background/preview.png" alt="App preview" />
    </div>
</div>